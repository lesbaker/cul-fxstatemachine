# --- graphics and animation ------------------------------------------
@value
class GameSprite {
  source: Long
  src_x: Long
  src_width: Long

  new(@source, @src_x, @src_width) {}
}

fn draw_to_canvas(spr: GameSprite, draw_x: Long, draw_y: Long) {
  canv_sprites[spr.source].draw_sub(draw_x, draw_y, spr.src_x, 0, spr.src_width, 16)
}

# A single picture element of an animation, shown for
# (frames / 60) seconds long.
@value
class AnimCell {
  sprite: GameSprite
  frames: Long

  new(@sprite, @frames) {}
}

class AnimTimeline {
  timeline: Array<AnimCell>
  index_tbl: Array<Long>

  new(@timeline: Array<AnimCell>) {
    # Compute look up table mapping frame number to the
    # corresponding cell index in its animation timeline
    self.index_tbl = timeline.iter()
      .map(|cell| cell.frames)
      .enumerate()
      .flat_map(|(idx, frames)| repeat(frames, idx))
      .collect()
  }

  total_frames() -> Long { self.index_tbl.size() }

  cell_at_frame(frame: Long) -> AnimCell {
    throw "{frame} out of range" if frame >= self.total_frames()

    self.timeline[self.index_tbl[frame]]
  }
}

@value
class Anim {
  timeline: Long
  oneshot: Bool
  start_fc: Long

  new(@timeline: Long, @start_fc: Long, @oneshot = false) {}

  reset(start_fc) -> Anim {
    Anim(
      timeline: self.timeline,
      start_fc: start_fc,
      oneshot: self.oneshot,
    )
  }
}

fn compute_frame(anim: Anim, fc: Long) -> Long {
  let delta = fc - anim.start_fc
  let tl = anims[anim.timeline]

  if (anim.oneshot) {
    delta < tl.total_frames() ? delta : 0
  } else {
    delta % tl.total_frames()
  }
}

enum FlapData {
  Happened(Long),
  NoFlap,
}

class Player {
  static START_X = 70
  static START_Y = 40
  # How long (in frames: 60 fps assumed) to throttle the player
  # from being able to flap Rocci's wings again
  static FLAP_DELAY = 12  # 0.2 seconds
  # Rocci's bounding box is shrunk slightly on all sides to prevent spurious
  # hits from non-player pixels in the box (and because it's better to err
  # on the side of the player when one hit ends the game).
  static BB_SHRINK_W = 4
  static BB_SHRINK_H = 4

  x: Long
  y: Float
  vel: Float
  last_flap_frame: Long

  new(@x = Player.START_X, @y = to_float(Player.START_Y), @vel = JUMP, @last_flap_frame = 0) {}

  update(flap: FlapData) -> Player {
    match flap {
      FlapData.Happened(frame) => {
        Player(
          x: self.x + 1,
          y: Math.min(self.y + JUMP, 134.0),
          vel: JUMP,
          last_flap_frame: frame,
        )
      },
      FlapData.NoFlap() => {
        let vel = self.vel + GRAVITY

        Player(
          x: self.x + 1,
          y: Math.min(self.y + vel, 134.0),
          vel: vel,
          last_flap_frame: self.last_flap_frame,
        )
      }
    }
  }

  update_over() {
    let vel = self.vel + GRAVITY

    Player(
      x: self.x,
      y: Math.min(self.y + vel, 134.0),
      vel: vel,
      last_flap_frame: self.last_flap_frame,
    )
  }
}

@value
class Viewport {
  x: Long  # The left edge x (base) world coordinate
  width: Long

  new(@x, @width) {}

  shift_right(amount: Long = 1) -> Viewport {
    Viewport(self.x + amount, self.width)
  }

  # Returns the given world-space coordinate relative to this viewport
  to_vp(world_x: Long) -> Long {
    world_x - self.x
  }

  # Returns the given viewport-relative coordinate translated to world space
  to_world(vp_x: Long) -> Long {
    self.x + vp_x
  }
}

class World {
  vp: Viewport
  seed: Long

  new(@seed) {
    self.vp = Viewport(0, W)
  }

  new(@vp, @seed) {}

  shift_vp_right() {
    World(@vp.shift_right(), @seed)
  }

  plants() -> Array<Object> {
    let offset_left = (self.vp.x % PLANT_WIDTH)
    let plant_area = W + offset_left
    let partial_plant_on_r: Bool = (plant_area % PLANT_WIDTH) > 0
    let num_plants = (plant_area / PLANT_WIDTH) + (partial_plant_on_r ? 1 : 0)

    iota(num_plants)
      .map(|i| {
        let computed_x = (self.vp.x - offset_left) + (i * PLANT_WIDTH)
        {
          x: computed_x,
          type: noise1d(computed_x, self.seed) % PLANT_TYPES
        }
      }
    )
  }
}

# The computation of the pipe index range lower..=upper is based
# on the following linear inequality:
#   x_base <= Ix + (W + I) <= x_max
# where I is the interval between pipe spawns and W is the viewport width.
#
# The first pipe (index 0) starts at x coordinate (W + I) because,
# in the original code, a counter increments to the pipe interval value (I)
# before the first spawn happens at the right edge of the screen (W).
#
# Isolating the result variable we get:
# (x_base - W - I) / I <= x <= (x_max - W - I) / I
# Since x_max = ViewportX + W then W cancels out and we finally have:
# (x_base - W - I) / I <= x <= (vp.x - I) / I
# Then since the result is in the integer domain
# we ceil the lower bound and floor the upper
class PipesOnScreen {
  data: Array<Object>

  new() {
    self.data = []
  }

  new(world: World) {
    let x_base = world.vp.x - PIPE_WIDTH
    let seed = world.seed
    let lower = Math.ceil((x_base - W - PIPE_IVAL) / PIPE_IVAL.to_float())
    let upper = Math.floor((world.vp.x - PIPE_IVAL) / PIPE_IVAL.to_float())
    let FIRST_PIPE_X: Long = W + PIPE_IVAL

    self.data = range(lower, upper + 1)
      .filter(|i| i >= 0)  # eliminate spurious results
      .map(|i| {
        idx: i,
        x: PIPE_IVAL * i + FIRST_PIPE_X,
        gap_start: (noise1d(i, seed) % 16) * 5 + 10,
      })
      .collect()
  }
}

fn draw(pipes: PipesOnScreen, vp: Viewport) {
  for {x, gap_start} in pipes.data {
    canv_sprites[SPR_IDX_PIPE].draw(  # top pipe, flipped vertically
      vp.to_vp(x),
      gap_start - H,
      false, true
    )
    canv_sprites[SPR_IDX_PIPE].draw(  # bottom pipe
      vp.to_vp(x),
      gap_start + GAP
    )
  }
}

# Returns index of last pipe on-screen that Rocci has passed;
# -1 if he has not passed one
#
# A return of -1 does NOT mean that Rocci hasn't passed a pipe this game
fn last_passed(pipes: PipesOnScreen, rocci: Player) -> Long {
  let pipe = pipes.data.iter().find(|p| rocci.x >= p.x)

  pipe?.idx ?? -1
}

# Return the bounding boxes for the pipes on-screen
fn compute_bboxes(pipes: PipesOnScreen) -> Array<Object> {
  pipes.data.flat_map(
    |p| [
      {x: p.x, y: p.gap_start - 160, w: 20, h: 160},
      {x: p.x, y: p.gap_start + GAP, w: 20, h: 160}
    ]
  )
}

fn flap_allowed(rocci: Player, fc: Long) -> Bool {
  fc - rocci.last_flap_frame > Player.FLAP_DELAY
}

let ANIM_TL_IDX_IDLE = 0
let ANIM_TL_IDX_FLAP = 1
let ANIM_TL_IDX_FALL = 2
let ANIM_TL_IDX_HISCORE = 3

let anims = [
  AnimTimeline([
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 0, 16), 17),
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 16, 16), 6),
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 32, 16), 17),
  ]),
  AnimTimeline([
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 0, 16), 1),
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 16, 16), 6),
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 32, 16), 12),
  ]),
  AnimTimeline([
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 48, 16), 10),
    AnimCell(GameSprite(SPR_IDX_ROCCI_SHEET, 64, 16), 10),
  ]),
  AnimTimeline([
    AnimCell(GameSprite(SPR_IDX_HISCORE_SHEET, 0, 32), 5),
    AnimCell(GameSprite(SPR_IDX_HISCORE_SHEET, 32, 32), 5),
    AnimCell(GameSprite(SPR_IDX_HISCORE_SHEET, 64, 32), 5),
    AnimCell(GameSprite(SPR_IDX_HISCORE_SHEET, 96, 32), 5),
  ]),
]

let idle_anim = |fc| Anim(
  ANIM_TL_IDX_IDLE,
  fc,
)
let flap_anim = |fc| Anim(
  ANIM_TL_IDX_FLAP,
  fc,
  oneshot: true,
)
let fall_anim = |fc| Anim(
  ANIM_TL_IDX_FALL,
  fc,
)
let hiscore_anim = |fc| Anim(
  ANIM_TL_IDX_HISCORE,
  fc,
)

# --- collision handling ---
# A hit occurs when Rocci's bounding box intersects with any of the pipe
# bounding boxes. As documented above, we shrink Rocci's box a bit on both axes.
fn collided(rocci: Player, pipe_bboxes: Array) -> Bool {
  # If the player tries to cheese the game by flying out-of-bounds,
  # we keep the collision box pinned to the top of the screen
  let coll_y = Math.clamp(rocci.y.to_long(), 0, 134)
  let rocci_bbox = {
    x: rocci.x + Player.BB_SHRINK_W,
    y: coll_y + Player.BB_SHRINK_H,
    w: 16 - 2 * Player.BB_SHRINK_W,
    h: 16 - 2 * Player.BB_SHRINK_H,
  }
  let rocci_overlap = |x, y, w, h| Canvas.rect_overlap(
    x1: x,
    y1: y,
    w1: w,
    h1: h,
    x2: rocci_bbox.x,
    y2: rocci_bbox.y,
    w2: rocci_bbox.w,
    h2: rocci_bbox.h,
  )

  # Uncomment the two lines below to highlight all bounding boxes w/ red square
  # Canvas.rect(rocci_bbox.x, rocci_bbox.y, rocci_bbox.w, rocci_bbox.h, Canvas.rgba(255, 0, 0), fill: false)
  # pipe_bboxes.for_each(|bb| Canvas.rect(bb.x, bb.y, bb.w, bb.h, Canvas.rgba(255, 0, 0), fill: false))

  pipe_bboxes.any(|bbox| rocci_overlap(**bbox))
}

# --- drawing helpers -------------------------------------------------------
let draw_ground = fn (x) {
  canv_sprites[SPR_IDX_GROUND].draw(x, GROUND_Y)
  canv_sprites[SPR_IDX_GROUND].draw(x + W, GROUND_Y)
}
let draw_plants = fn (base_x, plants) {
  for {x, type} in plants {
    canv_sprites[SPR_IDX_PLANT_SHEET].draw_sub(x - base_x, PLANT_Y, type * 12, 0, 12, 12)
  }
}

let draw_score = fn (score, base_x, y) {
  let x = match score {
    ..10 => base_x + 8,
    ..100 => base_x + 4,
    _ => base_x,
  }
  Canvas.text(to_string(score), x, y, C4)
}

# --- high score ------------------------------------------------------------
# The platform's per-user data directory, which is also the one directory the
# Playground makes durable — so the score survives a reload in the browser and
# a restart natively, from the same two lines.
let score_file = fn () {
  FS.join(Sys.data_dir("rocci-bird"), "score.json")
}

let load_high_score_from_file = fn () {
  try {
    let f = score_file()
    FS.exists(f) ? to_long(JSON.parse(FS.read(f)).high) : 0
  } catch e {
    0  # a file this game did not write, or wrote in an older shape
  }
}

let save_high_score_to_file = fn (score) {
  try {
    let f = score_file()
    FS.mkdir(FS.dirname(f))
    FS.write(f, JSON.stringify({high: score}))
  } catch e {
    nil  # nowhere to write is not a reason to stop the game
  }
}

# Gives an y-axis drawing offset that helps animate Rocci
# bobbing up and down on the title screen
let idle_shift = fn (title_start_frame: Long, fc: Long) -> Long {
  if (Math.wrap(title_start_frame - fc, 40) > 20) { 0 } else { 1 }
}

let update_session = fn (s: Object) -> Object {
  { ...s, fc: s.fc + 1 }
}

# --- app -------------------------------------------------------------------
enum Mode {
  Initial,
  Title,
  Game,
  Over,
  Final, # entering this state closes the app
}

let assign_all = fn (target: Object, source: Object) {
  for k, v in source {
    target[k] = v
  }
}

fn on_enter(state: Mode.Title, payload: Object) {
  payload.upsert('title', {
    world: World(payload.session.fc),
    rocci: Player(),
    rocci_anim: idle_anim(payload.session.fc),
    start_frame: payload.session.fc,
  })
}

fn on_enter(state: Mode.Game, payload: Object) {
  let fc = payload.session.fc

  # The original reseeds from the frame count at the moment play begins, so
  # the run feels randomly seeded (players rarely start on the same frame).
  perform seed_prng(fc)
  perform play_sound("flap")

  payload.upsert('game', {
    mut game_fc: 0,
    mut world: payload.title.world,
    mut rocci: Player(last_flap_frame: 0),
    mut rocci_anim: flap_anim(0),
    mut last_pipe_scored_idx: -1,
    mut score: 0,
    mut max_score: 0,
    mut ground_x: 0,
    mut last_flap: true,
  })
}

fn on_enter(state: Mode.Over, payload: Object) {
  let new_high = payload.game.max_score > payload.session.high_score

  perform save_high_score(payload.session.high_score) if new_high
  perform play_sound("death")

  let session = {...payload.session}
  session.high_score = payload.game.max_score if new_high

  payload.upsert('session', session)
  payload.upsert('over', {
    world: payload.game.world,
    mut rocci: Player(
      x: payload.game.rocci.x,
      y: payload.game.rocci.y,
      vel: payload.game.rocci.vel,
    ),
    rocci_anim: fall_anim(payload.session.fc),
    last_game_score: payload.game.score,
    new_high: new_high,
    mut hiscore_anim: hiscore_anim(payload.session.fc),
    ground_x: payload.game.ground_x,
  })
}

fn update(state: Mode.Initial, this: Object) -> Object? {
  # Session state, alive across restarts.
  this.session = {
    interactive: IO.stdin_is_terminal(),
    mut high_score: perform load_high_score(),
    mut fc: 0,
  }
  # Per-mode state
  perform seed_prng(0)

  Mode.Title
}

fn update(state: Mode.Title, mut this: Object) -> Object? {
  let start_input = fn () {
    this.session.interactive ? perform get_input_action_held() : true
  }
  this.session = update_session(this.session)
  perform clear_screen(C1)

  perform draw_title_text()
  let plants = this.title.world.plants()
  perform draw_background(this.title.world.vp, 0, plants, PipesOnScreen())
  let player_draw_y = Player.START_Y + idle_shift(this.title.start_frame, this.session.fc)
  perform draw_animation(this.title.rocci_anim, this.session.fc, Player.START_X, player_draw_y)

  if (Canvas.key('escape')) {
    return Mode.Final
  }
  if (this.start_input()) {
    return Mode.Game
  }
  nil
}

fn update(state: Mode.Game, this: Object) -> Object? {
  let flap_input = fn () {
    this.session.interactive
      ? perform get_input_action_held()
      : this.game.rocci.vel > 0.0 && this.game.rocci.y > 70.0
  }
  this.session = update_session(this.session)
  perform clear_screen(C1)

  let fc = this.game.game_fc
  let flap_inp_down = flap_input()
  let flap_pressed = !this.game.last_flap && flap_inp_down
  let flap: FlapData = if flap_pressed && this.game.rocci.flap_allowed(fc) {
    this.game.rocci_anim = this.game.rocci_anim.reset(fc)
    FlapData.Happened(fc)
  } else {
    FlapData.NoFlap
  }

  this.game.last_flap = flap_inp_down
  perform play_sound("flap") if type_of(flap) == 'Happened'

  let pipes = PipesOnScreen(this.game.world)
  let last_pipe_scored_idx = pipes.last_passed(this.game.rocci)

  this.game.rocci = this.game.rocci.update(flap)
  this.game.ground_x = (this.game.ground_x - 1) % W

  # Did we just score a point?
  if last_pipe_scored_idx > this.game.last_pipe_scored_idx {
    this.game.last_pipe_scored_idx = last_pipe_scored_idx
    this.game.score = Math.min(last_pipe_scored_idx + 1, 255)
    this.game.max_score = Math.max(this.game.score, this.game.max_score)
    perform play_sound("point")
  }

  perform draw_background(
    this.game.world.vp,
    this.game.ground_x,
    this.game.world.plants(),
    pipes,
  )

  let hit = this.game.rocci.collided(pipes.compute_bboxes())
  perform draw_animation(this.game.rocci_anim, fc, this.game.world.vp.to_vp(this.game.rocci.x), this.game.rocci.y.to_long())
  perform draw_game_info(this.game.score)

  this.game.world = this.game.world.shift_vp_right()
  this.game.game_fc += 1

  if (Canvas.key('escape')) {
    return Mode.Final
  }
  if (hit || this.game.rocci.y >= 134.0) {
    return Mode.Over
  }
  nil
}

fn update(state: Mode.Over, this: Object) -> Object? {
  let restart_input = fn () {
    return true if !this.session.interactive
    perform get_input_alt_action_held()
  }
  this.session = update_session(this.session)
  perform clear_screen(C1)

  this.over.rocci = this.over.rocci.update_over()

  let pipes = PipesOnScreen(this.over.world)

  perform draw_background(
    this.over.world.vp,
    this.over.ground_x,
    this.over.world.plants(),
    pipes,
  )
  perform draw_animation(this.over.rocci_anim, this.session.fc, this.over.world.vp.to_vp(this.over.rocci.x), this.over.rocci.y.to_long())

  perform draw_game_over_info(this.over.last_game_score, this.session.high_score)
  perform draw_animation(this.over.hiscore_anim, this.session.fc, 64, 0) if this.over.new_high

  if (Canvas.key('escape')) {
    return Mode.Final
  }
  if (this.restart_input()) {
    return Mode.Title
  }
  nil
}

fn update(state: Mode.Final, this: Object) {
  Canvas.quit()
  nil
}

class App {
  machine: Machine

  new() {
    self.machine = fsm.Machine(Mode.Initial, on_enter: on_enter)
    self.input = Canvas.Input()
  }

  action_held() {
  }
  # In-game flap and title start read the action, with a simple autopilot when
  # input is not interactive so a CI / headless run still plays the game.
  flap_input() {
    self.session.interactive
      ? self.action_held()
      : self.game.rocci.vel > 0.0 && self.game.rocci.y > 70.0
  }
  start_input() {
    self.session.interactive ? self.action_held() : true
  }
  restart_input() {
    return true if !self.session.interactive
  }

  tick() {
    self.input.update()

    handle {
      let new_state = update(self.machine._state, self.machine._payload)

      if new_state != nil {
        let modded_payload = self.machine.transition(new_state, self.machine._payload)
        assign_all(self.machine._payload, modded_payload)
      }
    } with seed_prng(seed, resume) {
      Random.seed(seed)

      resume()
    } with get_input_action_held(resume) {
      # The "flap / start" action: A, up, or left-click held this frame.
      let m = Canvas.mouse()
      let is_held = self.input.down(Canvas.A) ||
        self.input.down(Canvas.UP) ||
        m.buttons & 1 != 0
      resume(is_held)
    } with get_input_alt_action_held(resume) {
      let m = Canvas.mouse()
      let is_held = self.input.down(Canvas.B) ||
        self.input.down(Canvas.RIGHT) ||
        m.buttons & 2 != 0
      resume(is_held)
    } with clear_screen(color, resume) {
      Canvas.clear(color)

      resume()
    } with play_sound(sound_name, resume) {
      sound_args = sounds[sound_name]
      Audio.tone(**sound_args)

      resume()
    } with draw_animation(anim, fc, draw_x, draw_y, resume) {
      let render_frame: Long = anim.compute_frame(fc)
      let cell: AnimCell = anims[anim.timeline].cell_at_frame(render_frame)
      cell.sprite.draw_to_canvas(draw_x.to_long(), draw_y.to_long())

      resume()
    } with draw_background(vp, ground, plants, pipes, resume) {
      pipes.draw(vp)
      draw_ground(ground)
      draw_plants(vp.x, plants)

      resume()
    } with draw_title_text(resume) {
      Canvas.text("Rocci Bird!!!", 32, 12, C4)
      Canvas.text("Click to start!", 24, 72, C4)

      resume()
    } with draw_game_info(score, resume) {
      draw_score(score, 68, 4)

      resume()
    } with draw_game_over_info(score, high_score, resume) {
      Canvas.rect(16, 52, 136, 32, C1)
      Canvas.text("Game Over!", 44, 56, C4)
      Canvas.text("Right to restart", 20, 72, C4)
      Canvas.text("Art by Luke DeVault", 4, 151, C4)
      Canvas.rect(66, 2, 28, 12, C1)
      draw_score(score, 68, 4)
      Canvas.rect(54, 18, 52, 12, C1)
      Canvas.text("HS:", 57, 20, C4)
      draw_score(high_score, 80, 20)

      resume()
    } with load_high_score(resume) {
      resume(load_high_score_from_file())
    } with save_high_score(score, resume) {
      save_high_score_to_file(score)

      resume()
    }

    true
  }
}

let app = App()
Canvas.title("Rocci Bird")
Canvas.run(W, H, app.tick)
