# Rocci Bird — a faithful culebra port of Brendan Hansknecht's WASM-4 demo
# (art by Luke DeVault), from Luke Boswell's roc-wasm4 platform
# (github.com/lukewilliamboswell/roc-wasm4, examples/rocci-bird.roc). The five
# 2BPP sprite sheets, the Lospec "Candy Cloud" palette, the physics, the
# pixel-readback collision, the ADSR tones, and the three-state flow (title ->
# game -> game over) are reproduced from the original.
#
# roc-wasm4 is UPL-1.0 licensed (Copyright (c) 2023 Luke Boswell and
# subsequent authors) — see the LICENSE.md there.
#
# WASM-4 draws indexed 2BPP art through a per-draw "draw colors" remap; this
# game uses a fixed remap per asset, so each sheet is baked once into an indexed
# Canvas.Sprite (index 0 transparent for the sprites, the background colour for
# the ground). The high score is kept in `Sys.data_dir`, so it survives a
# restart natively and a reload in the Playground, which makes that one
# directory durable.

# --- palette ---------------------------------------------------------------
let C1 = Canvas.rgba(0xe6, 0xe6, 0xc0)  # background / lightest
let C2 = Canvas.rgba(0xb4, 0x94, 0xb7)
let C3 = Canvas.rgba(0x42, 0x43, 0x6e)
let C4 = Canvas.rgba(0x26, 0x01, 0x3f)  # darkest / text
let CLEAR = Canvas.rgba(0, 0, 0, 0)
let SPRITE_PAL = [CLEAR, C2, C3, C4]  # set_draw_colors: None, C2, C3, C4
let GROUND_PAL = [C1, C2, C3, C4]     # set_draw_colors: C1, C2, C3, C4

# --- 2BPP sprite decoding --------------------------------------------------
# WASM-4 2BPP: a continuous bitstream, MSB first, 4 pixels per byte, each pixel
# a palette index 0..3. All our sheet widths are byte-aligned per row.
let decode2bpp = fn (bytes, w, h) {
  iota(w * h).map(|n| bytes[n / 4] >> 6 - 2 * (n % 4) & 3)
}

let load_sprite = fn (hex, w, h, pal) {
  let bytes = Encoding.hex.decode(hex).bytes().collect()
  Canvas.Sprite(decode2bpp(bytes, w, h), w, h, pal)
}

let rocci_sheet = load_sprite(
  "",
  80,
  16,
  SPRITE_PAL,
)
let ground_sprite = load_sprite(
  "",
  160,
  13,
  GROUND_PAL,
)
let pipe_sprite = load_sprite(
  "",
  20,
  160,
  SPRITE_PAL,
)
let plant_sheet = load_sprite(
  "",
  360,
  12,
  SPRITE_PAL,
)
let hiscore_sheet = load_sprite(
  "",
  128,
  16,
  SPRITE_PAL,
)

# --- constants (from the original) -----------------------------------------
let W = 160
let H = 160
let GRAVITY = 0.12
let JUMP = -2.2
let GAP = 40
let PLAYER_X = 70
let PLAYER_START_Y = 40
# Rocci's bounding box is shrunk slightly on all sides to prevent spurious
# hits from non-player pixels in the box (and because it's better to err
# on the side of the player when one hit ends the game).
let PLAYER_BB_SHRINK_W = 4
let PLAYER_BB_SHRINK_H = 4
# How long (in frames: 60 fps assumed) to throttle the player
# from being able to flap Rocci's wings again
let PLAYER_FLAP_DELAY = 12  # 0.2 seconds
let GROUND_Y = H - 13  # 147
let PLANT_Y = H - 22   # 138
let PLANT_TYPES = 30

effect fn seed_prng(seed: Long)
effect fn clear_screen(color: Object)
effect fn play_sound(sound_name: String)
effect fn draw_animation(anim: Anim, x: Long, y: Long)
effect fn draw_background(ground: Long, plants: Array)
effect fn draw_pipes(pipes: Array)
effect fn draw_title_text()
effect fn draw_game_info(score: Long)
effect fn draw_game_over_info(score: Long, high_score: Long, new_high: Bool, hiscore: Object)
effect fn load_high_score()
effect fn save_high_score(score: Long)

# --- tones (exact WASM-4 parameters) ---------------------------------------
# tone(freq, sustain, vol, wave, end_freq, attack, decay, release, peak, duty)
let sounds = {
  "flap": {
    "freq": 700,
    "dur": 0,
    "vol": 10,
    "wave": Canvas.PULSE,
    "end_freq": 870,
    "attack": 10,
    "decay": 5,
    "release": 3,
    "peak": 20,
    "duty": Canvas.DUTY_QUARTER,
  },
  "point": {
    "freq": 995,
    "dur": 0,
    "vol": 25,
    "wave": Canvas.PULSE2,
    "end_freq": 1000,
    "attack": 0,
    "decay": 10,
    "release": 10,
    "peak": 75,
    "duty": Canvas.DUTY_HALF,
  },
  "death": {
    "freq": 170,
    "dur": 20,
    "vol": 100,
    "wave": Canvas.NOISE,
    "end_freq": 40,
    "attack": 0,
    "decay": 40,
    "release": 0,
    "peak": 0,
    "duty": Canvas.DUTY_HALF,
  },
}

# --- animation -------------------------------------------------------------
# cells is a list of [frames, src_x]; every frame is `sw`x16 on `sheet`.
enum AnimState {
  Loop,
  RunOnce,
  Completed,
}

class Anim {
  new(sheet, sw, cells, fc, index, state) {
    self.sheet = sheet
    self.sw = sw
    self.cells = cells
    self.index = index
    self.state = state  # an AnimState
    self.last_updated = fc
  }
  reset(fc, index, state) {
    self.index = index
    self.state = state
    self.last_updated = fc
  }
  update(fc) {
    let fpu = self.cells[self.index][0]
    return if fc - self.last_updated < fpu
    let ni = (self.index + 1) % self.cells.size()
    match self.state {
      s: Completed => {
        self.last_updated = fc
      },
      s: Loop => {
        self.index = ni
        self.last_updated = fc
      },
      s: RunOnce => {
        if ni == 0 {
          self.state = AnimState.Completed
        } else {
          self.index = ni
        }
        self.last_updated = fc
      },
    }
  }
}

let idle_anim = |fc| Anim(
  rocci_sheet,
  16,
  [[17, 0], [6, 16], [17, 32]],
  fc,
  0,
  AnimState.Loop,
)
let flap_anim = |fc| Anim(
  rocci_sheet,
  16,
  [[6, 16], [12, 32], [1, 0]],
  fc,
  2,
  AnimState.Completed,
)
let fall_anim = |fc| Anim(
  rocci_sheet,
  16,
  [[10, 48], [10, 64]],
  fc,
  0,
  AnimState.Loop,
)
let hiscore_anim = |fc| Anim(
  hiscore_sheet,
  32,
  [[5, 0], [5, 32], [5, 64], [5, 96]],
  fc,
  0,
  AnimState.Loop,
)

# --- collision handling ---
# A hit occurs when Rocci's bounding box intersects with any of the pipe
# bounding boxes. As documented above, we shrink Rocci's box a bit on both axes.
let collided = fn (player_y, pipe_bboxes) {
  let rocci_bbox = {
    x: PLAYER_X + PLAYER_BB_SHRINK_W,
    y: player_y + PLAYER_BB_SHRINK_H,
    w: 16 - 2 * PLAYER_BB_SHRINK_W,
    h: 16 - 2 * PLAYER_BB_SHRINK_H,
  }
  let rocci_overlap = |x, y, w, h| Canvas.rect_overlap(
    x1: x,
    y1: y,
    w1: w,
    h1: h,
    x2: rocci_bbox.x,
    y2: rocci_bbox.y,
    w2: rocci_bbox.w,
    h2: rocci_bbox.h,
  )

  # Uncomment the two lines below to highlight all bounding boxes w/ red square
  # Canvas.rect(rocci_bbox.x, rocci_bbox.y, rocci_bbox.w, rocci_bbox.h, Canvas.rgba(255, 0, 0), fill: false)
  # pipe_bboxes.for_each(|bb| Canvas.rect(bb.x, bb.y, bb.w, bb.h, Canvas.rgba(255, 0, 0), fill: false))

  pipe_bboxes.any(|bbox| rocci_overlap(**bbox))
}

# --- drawing helpers -------------------------------------------------------
let shift_left = |p| {...p, x: p.x - 1}
let draw_ground = fn (x) {
  ground_sprite.draw(x, GROUND_Y)
  ground_sprite.draw(x + W, GROUND_Y)
}
let draw_plants = fn (plants) {
  for {x, type} in plants {
    plant_sheet.draw_sub(x, PLANT_Y, type * 12, 0, 12, 12)
  }
}
let draw_score = fn (score, base_x, y) {
  let x = match score {
    ..10 => base_x + 8,
    ..100 => base_x + 4,
    _ => base_x,
  }
  Canvas.text(to_string(score), x, y, C4)
}

# --- high score ------------------------------------------------------------
# The platform's per-user data directory, which is also the one directory the
# Playground makes durable — so the score survives a reload in the browser and
# a restart natively, from the same two lines.
let score_file = fn () {
  FS.join(Sys.data_dir("rocci-bird"), "score.json")
}

let load_high_score_from_file = fn () {
  try {
    let f = score_file()
    FS.exists(f) ? to_long(JSON.parse(FS.read(f)).high) : 0
  } catch e {
    0  # a file this game did not write, or wrote in an older shape
  }
}

let save_high_score_to_file = fn (score) {
  try {
    let f = score_file()
    FS.mkdir(FS.dirname(f))
    FS.write(f, JSON.stringify({high: score}))
  } catch e {
    nil  # nowhere to write is not a reason to stop the game
  }
}

# Gives an y-axis drawing offset that helps animate Rocci
# bobbing up and down on the title screen
let idle_shift = fn (title_start_frame: Long, fc: Long) -> Long {
  if (Math.wrap(title_start_frame - fc, 40) > 20) { 0 } else { 1 }
}

let flap_allowed = fn (last_flap: Long, fc: Long) -> Bool {
  fc - last_flap > PLAYER_FLAP_DELAY
}

let update_session = fn (s: Object) {
  s.input.update()
  s.fc += 1
}

# --- app -------------------------------------------------------------------
enum Mode {
  Initial,
  Title,
  Game,
  Over,
  Final, # entering this state closes the app
}

class App {
  new() {
    self.mode = Mode.Initial
  }

  starting_plants() {
    iota(15).map(|i| {x: i * 12, type: Random.int(0, PLANT_TYPES)})
  }

  enter_title() {
    self.mode = Mode.Title
    self.plants = self.starting_plants()
    self.rocci = idle_anim(self.session.fc)
    self.title_start_frame = self.session.fc
  }

  enter_game() {
    let fc = self.session.fc

    self.mode = Mode.Game
    # The original reseeds from the frame count at the moment play begins, so
    # the run feels randomly seeded (players rarely start on the same frame).
    perform seed_prng(fc)
    self.score = 0
    self.max_score = 0
    self.player_y = to_float(PLAYER_START_Y)
    self.player_vel = JUMP
    self.pipes = []
    self.last_pipe = fc
    self.last_plant = Math.max(fc - 4, 0)
    self.last_flap = true
    self.last_flap_frame = fc
    self.rocci = flap_anim(fc)
    self.ground_x = 0
    perform play_sound("flap")
  }

  enter_over() {
    self.mode = Mode.Over
    self.new_high = self.max_score > self.session.high_score
    self.session.high_score = self.max_score if self.new_high
    perform save_high_score(self.session.high_score) if self.new_high
    self.rocci = fall_anim(self.session.fc)
    self.hiscore = hiscore_anim(self.session.fc)
    perform play_sound("death")
  }

  enter_final() {
    Canvas.quit()
  }

  # The "flap / start" action: A, up, or left-click held this frame.
  action_held() {
    let m = Canvas.mouse()
    self.session.input.down(Canvas.A) ||
      self.session.input.down(Canvas.UP) ||
      m.buttons & 1 != 0
  }
  # In-game flap and title start read the action, with a simple autopilot when
  # input is not interactive so a CI / headless run still plays the game.
  flap_input() {
    self.session.interactive
      ? self.action_held()
      : self.player_vel > 0.0 && self.player_y > 70.0
  }
  start_input() {
    self.session.interactive ? self.action_held() : true
  }
  restart_input() {
    return true if !self.session.interactive
    let m = Canvas.mouse()
    self.session.input.down(Canvas.B) ||
      self.session.input.down(Canvas.RIGHT) ||
      m.buttons & 2 != 0
  }

  tick() {
    handle {
      match self.mode {
        m: Initial => self.tick_initial(),
        m: Title => self.tick_title(),
        m: Game => self.tick_game(),
        m: Over => self.tick_over(),
      }
    } with seed_prng(seed, resume) {
      Random.seed(seed)

      resume()
    } with clear_screen(color, resume) {
      Canvas.clear(color)

      resume()
    } with play_sound(sound_name, resume) {
      sound_args = sounds[sound_name]
      Canvas.tone(**sound_args)

      resume()
    } with draw_animation(anim, draw_x, draw_y, resume) {
      anim.sheet.draw_sub(draw_x, draw_y, anim.cells[anim.index][1], 0, anim.sw, 16)

      resume()
    } with draw_background(ground, plants, resume) {
      draw_ground(ground)
      draw_plants(plants)

      resume()
    } with draw_pipes(pipes, resume) {
      for {x, gap_start} in pipes {
        pipe_sprite.draw(x, gap_start - H, false, true)  # top pipe, flipped vertically
        pipe_sprite.draw(x, gap_start + GAP)             # bottom pipe
      }

      resume()
    } with draw_title_text(resume) {
      Canvas.text("Rocci Bird!!!", 32, 12, C4)
      Canvas.text("Click to start!", 24, 72, C4)

      resume()
    } with draw_game_info(score, resume) {
      draw_score(score, 68, 4)

      resume()
    } with draw_game_over_info(score, high_score, new_high, hiscore, resume) {
      Canvas.rect(16, 52, 136, 32, C1)
      Canvas.text("Game Over!", 44, 56, C4)
      Canvas.text("Right to restart", 20, 72, C4)
      Canvas.text("Art by Luke DeVault", 4, 151, C4)
      Canvas.rect(66, 2, 28, 12, C1)
      draw_score(score, 68, 4)
      Canvas.rect(54, 18, 52, 12, C1)
      Canvas.text("HS:", 57, 20, C4)
      draw_score(high_score, 80, 20)

      resume()
    } with load_high_score(resume) {
      resume(load_high_score_from_file())
    } with save_high_score(score, resume) {
      save_high_score_to_file(score)

      resume()
    }

    true
  }

  tick_initial() {
    # Session state, alive across restarts.
    self.session = {
      interactive: IO.stdin_is_terminal(),
      input: Canvas.Input(),
      mut high_score: perform load_high_score(),
      mut fc: 0,
    }
    # Per-mode state
    self.rocci = Anim
    self.hiscore = hiscore_anim(0)
    self.plants = []
    self.pipes = []
    self.score = 0
    self.max_score = 0
    self.player_y = 0.0
    self.player_vel = 0.0
    self.last_pipe = 0
    self.last_plant = 0
    self.last_flap = true
    self.new_high = false
    self.ground_x = 0
    perform seed_prng(0)

    self.enter_title()
  }

  tick_title() {
    update_session(self.session)
    perform clear_screen(C1)

    self.rocci.update(self.session.fc)
    perform draw_title_text()
    perform draw_background(0, self.plants)
    let player_draw_y = PLAYER_START_Y + idle_shift(self.title_start_frame, self.session.fc)
    perform draw_animation(self.rocci, PLAYER_X, player_draw_y)

    self.enter_final() if Canvas.key('escape')
    self.enter_game() if self.start_input()
  }

  tick_game() {
    update_session(self.session)
    perform clear_screen(C1)

    let flap = self.flap_input()
    if !self.last_flap && flap && flap_allowed(self.last_flap_frame, self.session.fc) {
      perform play_sound("flap")
      self.last_flap_frame = self.session.fc
      self.player_vel = JUMP
      self.rocci.reset(self.session.fc, 0, AnimState.RunOnce)
    } else {
      self.player_vel += GRAVITY
      self.rocci.update(self.session.fc)
    }
    self.last_flap = flap

    # pipes: spawn, move (scoring when a pipe crosses PLAYER_X - 2), cull
    if self.session.fc - self.last_pipe > 90 {
      self.pipes.push({x: W, gap_start: Random.int(0, 16) * 5 + 10})
      self.last_pipe = self.session.fc
    }
    let moved_pipes = self.pipes.map(shift_left)
    let gained = moved_pipes.filter(|p| p.x == PLAYER_X - 2).size()
    self.pipes = moved_pipes.filter(|p| p.x >= -20)

    # plants: spawn, move, cull
    if self.session.fc - self.last_plant > 12 {
      self.plants.push({x: W, type: Random.int(0, PLANT_TYPES)})
      self.last_plant = self.session.fc
    }
    self.plants = self.plants.map(shift_left).filter(|p| p.x >= -12)

    self.player_y += self.player_vel
    self.score = Math.min(self.score + gained, 255)
    self.max_score = Math.max(self.score, self.max_score)
    self.ground_x = (self.ground_x - 1) % W
    perform play_sound("point") if gained > 0

    perform draw_pipes(self.pipes)
    perform draw_background(self.ground_x, self.plants)

    let pipe_bboxes = self.pipes.flat_map(
      |p| [{x: p.x, y: p.gap_start - 160, w: 20, h: 160}, {x: p.x, y: p.gap_start + GAP, w: 20, h: 160}]
    )
    # If the player tries to cheese the game by flying out-of-bounds,
    # we keep the collision box pinned to the top of the screen
    let coll_y = Math.clamp(self.player_y.to_long(), 0, 134)
    let hit = collided(coll_y, pipe_bboxes)
    perform draw_animation(self.rocci, PLAYER_X, self.player_y)
    perform draw_game_info(self.score)

    self.enter_final() if Canvas.key('escape')
    self.enter_over() if hit || self.player_y >= 134.0
  }

  tick_over() {
    update_session(self.session)
    perform clear_screen(C1)

    self.player_vel += GRAVITY
    self.rocci.update(self.session.fc)
    self.hiscore.update(self.session.fc)
    self.player_y = Math.min(self.player_y + self.player_vel, 134.0)

    perform draw_pipes(self.pipes)
    perform draw_background(self.ground_x, self.plants)
    perform draw_animation(self.rocci, PLAYER_X, self.player_y.to_long())

    perform draw_game_over_info(self.score, self.session.high_score, self.new_high, self.hiscore)
    perform draw_animation(self.hiscore, 64, 0) if self.new_high

    self.enter_final() if Canvas.key('escape')
    self.enter_title() if self.restart_input()
  }
}

let app = App()
Canvas.title("Rocci Bird")
Canvas.run(W, H, app.tick)
