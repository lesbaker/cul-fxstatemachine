# Rocci Bird — a faithful culebra port of Brendan Hansknecht's WASM-4 demo
# (art by Luke DeVault), from Luke Boswell's roc-wasm4 platform
# (github.com/lukewilliamboswell/roc-wasm4, examples/rocci-bird.roc). The five
# 2BPP sprite sheets, the Lospec "Candy Cloud" palette, the physics, the
# pixel-readback collision, the ADSR tones, and the three-state flow (title ->
# game -> game over) are reproduced from the original.
#
# roc-wasm4 is UPL-1.0 licensed (Copyright (c) 2023 Luke Boswell and
# subsequent authors) — see the LICENSE.md there.
#
# WASM-4 draws indexed 2BPP art through a per-draw "draw colors" remap; this
# game uses a fixed remap per asset, so each sheet is baked once into an indexed
# Canvas.Sprite (index 0 transparent for the sprites, the background colour for
# the ground). The high score is kept in `Sys.data_dir`, so it survives a
# restart natively and a reload in the Playground, which makes that one
# directory durable.

import fsm from './state.cul'

# Deterministic, random-access, 32-bit, fast hash function
# created by Brian "Squirrel" Eiserloh ported to Culebra
# http://eiserloh.net/noise/SquirrelNoise5.hpp
let noise1d = fn (posX: Long, seed: Long) {
  let SQ5_BIT_NOISE1: Long = 0xD2A80A3F
  let SQ5_BIT_NOISE2: Long = 0xA884F197
  let SQ5_BIT_NOISE3: Long = 0x6C736F4B
  let SQ5_BIT_NOISE4: Long = 0xB79F3ABB
  let SQ5_BIT_NOISE5: Long = 0x1B56C4F5
  let MASK_32: Long = 0xFFFFFFFF

  mut mangledBits: Long = posX

  mangledBits = (mangledBits * SQ5_BIT_NOISE1) & MASK_32
  mangledBits = (mangledBits + seed) & MASK_32
  mangledBits ^= (mangledBits >> 9)
  mangledBits = (mangledBits + SQ5_BIT_NOISE2) & MASK_32
  mangledBits ^= (mangledBits >> 11)
  mangledBits = (mangledBits * SQ5_BIT_NOISE3) & MASK_32
  mangledBits ^= (mangledBits >> 13)
  mangledBits = (mangledBits + SQ5_BIT_NOISE4) & MASK_32
  mangledBits ^= (mangledBits >> 15)
  mangledBits = (mangledBits * SQ5_BIT_NOISE5) & MASK_32
  mangledBits ^= (mangledBits >> 17)
  mangledBits
}

# --- palette ---------------------------------------------------------------
let C1 = Canvas.rgba(0xe6, 0xe6, 0xc0)  # background / lightest
let C2 = Canvas.rgba(0xb4, 0x94, 0xb7)
let C3 = Canvas.rgba(0x42, 0x43, 0x6e)
let C4 = Canvas.rgba(0x26, 0x01, 0x3f)  # darkest / text
let CLEAR = Canvas.rgba(0, 0, 0, 0)
let SPRITE_PAL = [CLEAR, C2, C3, C4]  # set_draw_colors: None, C2, C3, C4
let GROUND_PAL = [C1, C2, C3, C4]     # set_draw_colors: C1, C2, C3, C4

# --- 2BPP sprite decoding --------------------------------------------------
# WASM-4 2BPP: a continuous bitstream, MSB first, 4 pixels per byte, each pixel
# a palette index 0..3. All our sheet widths are byte-aligned per row.
let decode2bpp = fn (bytes, w, h) {
  iota(w * h).map(|n| bytes[n / 4] >> 6 - 2 * (n % 4) & 3)
}

let load_sprite = fn (hex, w, h, pal) {
  let bytes = Encoding.hex.decode(hex).bytes().collect()
  Canvas.Sprite(decode2bpp(bytes, w, h), w, h, pal)
}

# Indices must match canvas sprite array below
let SPR_IDX_ROCCI_SHEET = 0
let SPR_IDX_GROUND = 1
let SPR_IDX_PIPE = 2
let SPR_IDX_PLANT_SHEET = 3
let SPR_IDX_HISCORE_SHEET = 4

let canv_sprites = [
  load_sprite(  # Rocci (bird) spritesheet
    "",
    80,
    16,
    SPRITE_PAL,
  ),
  load_sprite(  # Ground sprite
    "",
    160,
    13,
    GROUND_PAL,
  ),
  load_sprite(  # Pipe sprite
    "",
    20,
    160,
    SPRITE_PAL,
  ),
  load_sprite(  # Plants spritesheet (and other stuff on ground)
    "",
    360,
    12,
    SPRITE_PAL,
  ),
  load_sprite(  # Hi-score spritesheet (blinking lights surrounding the score)
    "",
    128,
    16,
    SPRITE_PAL,
  ),
]

# --- constants (from the original) -----------------------------------------
let W = 160
let H = 160
let GRAVITY = 0.12
let JUMP = -2.2
let GAP = 40
let GROUND_Y = H - 13  # 147
let PLANT_Y = H - 22   # 138
let PLANT_TYPES = 30
let PLANT_WIDTH = 12
let PIPE_IVAL = 90  # Interval between pipe spawns
let PIPE_WIDTH = 20

effect fn seed_prng(seed: Long)
effect fn get_input_action_held()
effect fn get_input_alt_action_held()
effect fn clear_screen(color: Long)
effect fn play_sound(sound_name: String)
effect fn draw_animation(anim: Anim, fc: Long, x: Long, y: Long)
effect fn draw_background(vp: Viewport, ground: Long, plants: Array, pipes: PipesOnScreen)
effect fn draw_title_text()
effect fn draw_game_info(score: Long)
effect fn draw_game_over_info(score: Long, high_score: Long)
effect fn load_high_score()
effect fn save_high_score(score: Long)

